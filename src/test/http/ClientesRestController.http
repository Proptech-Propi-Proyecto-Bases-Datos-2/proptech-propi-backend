  "telefono": "ALyYdpxjcEKy79PKcK6AvQIAAADt7PxpKp0W3I7hawx4gyF/qrEWyXZEwVu3hFqlSF+a1R78b6+WboczEIpXtS9KHgY="
}

### Eliminar cliente
DELETE {{baseUrl}}/api/clientes/id/{{clienteId}}
