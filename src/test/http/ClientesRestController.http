  "tipoIdentificacion": "Cédula",
  "provincia": "Sanjose",
  "canton": "Curridal",
  "distrito": "Curridal",
  "barrio": "Centro",
  "profesion": "Camionero",
  "actividadEconomica": "Servicios",
